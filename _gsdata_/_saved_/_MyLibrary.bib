	year = {2002}}

@article{barberi2002_Weedmanagementorganic,
	abstract = {Use of organic fertilisers/amendments generally results in slower release of nutrients as compared to mineral fertilisation. Organic fertiliser/amendments may also represent a source of weed seeds, e.g.
when farmyard manure or compost are not sufficiently treated (Mt Pleasant \& Schlater, 1994). These
factors alter crop/weed competition and weed population dynamics both within and across growing
cycles, the latter as related to (1) carry over of nutrients and (2) weed seed input from organic materials and/or uncontrolled late-emerging weeds (Bastiaans \& Drenth, 1999; Liebman \& Davis,2000). A good practice is localisation of organic fertilisers/amendments close to the crop row, when this is feasible.
Phisical weed control is less effective than chemical weed control, both on the short and on the long term. In particular, successful Phisical Weed Control must rely on concurrent application of cultural weed management, aimed to (1) reduce weed emergence by using preventive methods (crop sequence choice, smother crops - soffocanti, primary tillage, false seedbed technique), and (2) reduce weed competition by improving crop competitive ability (appropriate use of crop genotypes, transplants, sowing/planting pattern, fertilisation strategy).},
	author = {Barberi, Paolo},
	journal = {Weed Research},
	keywords = {Tillage,competition,weeds,agricoltura biologica,weed control},
	number = {42},
	pages = {177-193},
	title = {Weed Management in Organic Agriculture: Are We Addressing the Right Isssues?},
	year = {2002}}

