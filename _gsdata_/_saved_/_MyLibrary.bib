@article{hong2007_Determinationspeciesarearelationships,
	abstract = {The minimum sampling areas (MSAs) for the shrub communities in the arid valley in the upper reach of the Minjiang River, China, were studied by fitting community species-area relationships using 3 types of equations. The MSAs were determined at the proportional factor ([rho]) 0.6, 0.7, 0.8 and 0.9. The proportional factors represent the proportion of the number of species within a sampling plot in the total number of species. The MSAs of the shrub communities at different elevations and on different slope faces for [rho] = 0.6, 0.7 and 0.8 were all around 100 m2. Hence, the MSAs could be set to be 100 m2 (10 m x 10 m) at 60\%-80\% precision levels. For [rho] = 0.9, that is, for a 90\% precision level, the MSAs were less than 200 m2 (10 m x 20 m). The MSAs and species richness increased gradually with the rising elevation. At the elevation below 2000 m, the MSAs and species richness on the north-facing slope were larger than those on the south-facing slope. However, at the elevation around 2200 m, there was no difference amongst different facing slopes. For the shrub communities in the arid valley in the upper reach of the Minjiang River, the species-area curves by fitting the first two equations are better than that by fitting the third equation.},
	author = {Hong, Chen and Yanqiong, Li and Shaowei, Zheng and Ling, Wang and Fei, He and Jun, Liu and Changlong, Mu},
	file = {/Users/andrea/Documents/_DBXAndrea/Zotero/storage/XAD3H7E3/Hong2007_Determination_of.pdf},
	journal = {Acta Ecologica Sinica},
	keywords = {minimal area,species/area curve,arid valley,elevation,shrub community,slope face,the upper reach of the Minjiang River},
	month = may,
	number = {5},
	pages = {1818--1825},
	title = {Determination of Species-Area Relationships and Minimum Sampling Area for the Shrub Communities in the Arid Valley in the Upper Reach of the {{Minjiang River}}, {{China}}},
	volume = {27},
	year = {2007}}

