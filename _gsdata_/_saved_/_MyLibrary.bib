@article{costanza1998_Modellingecologicaleconomic,
	abstract = {This special section contains a group of seven modelling studies covering a range of ecological and economic systems and problems. The models were all developed using STELLA, an icon-based programming language specifically designed for dynamic systems modelling. Models included in the special section cover: dinoflagellate (Phiesteria piscicida) dynamics as a result of coastal eutrophication, Menhaden fisheries management in the Chesapeake Bay, watershed characteristics affecting both brown trout habitat and beaver ponds, the impacts and economics of riparian buffer strips, the integrated ecology and economics of Brazilian mangroves, and the macroeconomy including natural resources and a range of critical assumptions about technical change and substitution.},
	author = {Costanza, Robert and Gottlieb, Sara},
