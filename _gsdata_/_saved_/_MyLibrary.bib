@article{Guoimprovedapproachsegmentation2010,
	abstract = {BACKGROUND: Starches are the main storage polysaccharides in plants and are distributed widely throughout plants including seeds, roots, tubers, leaves, stems and so on. Currently, microscopic observation is one of the most important ways to investigate and analyze the structure of starches. The position, shape, and size of the starch granules are the main measurements for quantitative analysis. In order to obtain these measurements, segmentation of starch granules from the background is very important. However, automatic segmentation of starch granules is still a challenging task because of the limitation of imaging condition and the complex scenarios of overlapping granules. RESULTS: We propose a novel method to segment starch granules in microscopic images. In the proposed method, we first separate starch granules from background using automatic thresholding and then roughly segment the image using watershed algorithm. In order to reduce the oversegmentation in watershed algorithm, we use the roundness of each segment, and analyze the gradient vector field to find the critical points so as to identify oversegments. After oversegments are found, we extract the features, such as the position and intensity of the oversegments, and use fuzzy c-means clustering to merge the oversegments to the objects with similar features. Experimental results demonstrate that the proposed method can alleviate oversegmentation of watershed segmentation algorithm successfully. CONCLUSIONS: We present a new scheme for starch granules segmentation. The proposed scheme aims to alleviate the oversegmentation in watershed algorithm. We use the shape information and critical points of gradient vector flow (GVF) of starch granules to identify oversegments, and use fuzzy c-mean clustering based on prior knowledge to merge these oversegments to the objects. Experimental results on twenty microscopic starch images demonstrate the effectiveness of the proposed scheme.},
	author = {Guo, Shengwen and Tang, Jinshan and Deng, Youping and Xia, Qun},
	doi = {10.1186/1471-2164-11-S2-S13},
	issn = {1471-2164},
	journal = {BMC Genomics},
	number = {Suppl 2},
	pages = {S13-S13},
	title = {An Improved Approach for the Segmentation of Starch Granules in Microscopic Images},
	volume = {11},
	year = {2010},
	bdsk-url-1 = {https://doi.org/10.1186/1471-2164-11-S2-S13}}

@inproceedings{OnofriLongtermcropyield2016,
	abstract = {This paper is based on a randomised Long Term Experiment (LTE) in central Italy, which was set-up in 1971 and is still running at present (2016). In this experiment, 13 rotations based on wheat are compared, wherein crop residues are either removed after harvest or buried into the soil at ploughing. This is the follow-up of a previous paper, which, in accordance with the original aims of this research study, concentrated on the agronomic sustainability of the above cropping systems. In this paper, we tried to address the problem of adaptation to climatic changes and concentrated on the resilience of the above cropping systems. The results showed that wheat yield in all cropping systems under study was not 'statically' stable, but it was subjected to strong fluctuations, according to weather conditions. Therefore, cropping systems heavily based on wheat appear not to be resilient, in the sense that they cannot maintain all their functions in case of increased frequency of unfavourable weather events. Data seemed to suggest that the most crucial aspects relate to the amount of rainfall and temperature late in the spring: possible changes of weather pattern in this period may have important consequences on wheat yield. Although this paper represents just a first attempt, it is clear that long-term yield data obtained in agriculture experiments, regardless of their original aims, hold the potential to provide useful information relating to climate changes. In general, exploiting the existent long term yield data to address the resilience of cropping systems may be a crucial issue for future research.},
	address = {Assisi, 7-9 april 2016},
	author = {Onofri, Andrea and Bonciarelli, Umberto and Benincasa, Paolo and Farneselli, Michela and Guiducci, Marcello},
	booktitle = {Sustainable {{Development}}, Human Health and Environmental Protection},
	file = {/Users/andrea/Documents/_DBXAndrea/OneDrive/Bibliografia/_personali/Onofri2016_Long-term_crop_yield_data_series_-_do_they_help.pdf},
	language = {en},
	publisher = {{CIRIAF}},
	title = {Long-Term Crop Yield Data Series: Do They Help Address the Needs Posed by Climate Changes?},
	year = {2016}}

@article{BelloSingleseedoxygenconsumption2016,
	abstract = {Seed germination is responsive to diverse environmental, hormonal and chemical signals. Germination rates (i.e. speed and distribution in time) reveal information about timing, uniformity and extent of germination in seed populations and are sensitive indicators of seed vigour and stress tolerance. Population-based threshold (PBT) models have been applied to describe germination responses to temperature, water potential, hormones, ageing and oxygen. However, obtaining detailed data on germination rates of seed populations requires repeated observations at frequent times to construct germination time courses, which is labour intensive and often impractical. Recently, instruments have been developed to measure repeatedly the respiration (oxygen consumption) of individual seeds following imbibition, providing complete respiratory time courses for populations of individual seeds in an automated manner. In this study, we demonstrate a new approach that enables the use of single-seed respiratory data, rather than germination data, to characterize the responses of seed populations to diverse conditions. We applied PBT models to single-seed respiratory data and compared the results to similar analyses of germination time courses. We found consistent and quantitatively comparable relationships between seed respiratory and germination patterns in response to temperature, water potential, abscisic acid, gibberellin, respiratory inhibitors, ageing and priming. This close correspondence between seed respiration and germination time courses enables the use of semi-automated respiratory measurements to assess seed vigour and quality parameters. It also raises intriguing questions about the fundamental relationship between the respiratory capacities of seeds and the rates at which they proceed toward completion of germination.},
	author = {Bello, Pedro and Bradford, Kent J.},
	doi = {10.1017/S0960258516000179},
	file = {/Users/andrea/Documents/_DBXAndrea/OneDrive/Bibliografia/SeedGermination/Bello2016_Single-seed_oxygen_consumption_measurements_and.pdf},
	issn = {0960-2585, 1475-2735},
	journal = {Seed Science Research},
	language = {en},
	month = sep,
	number = {03},
	pages = {199-221},
	title = {Single-Seed Oxygen Consumption Measurements and Population-Based Threshold Models Link Respiration and Germination Rates under Diverse Conditions},
	volume = {26},
	year = {2016},
	bdsk-url-1 = {https://doi.org/10.1017/S0960258516000179}}

