@article{kenkel2002_Multivariateanalysisweed,
	abstract = {Data contammg many variables are often collected in weed science research, but until recently few weed scientists have used multivariate statistica! methods to examine such data. Multivariate ana!ysis can be used for both descriptive and predictive modeling. This paper provides an intuitive geometric introduction to the more commonly used and relevant multivariate methods in weed science research, including ordination, discriminant analysis, and canonica! analysis. These methods are illustrated using a simple artificia! data set consisting of abundance measures of six weed species and two soil variables over 12 sample plots. Canonical correlation analysis (CANCOR), canonica! correspondence analysis $\dottedsquare$(CCA), $\dottedsquare$canonica! discriminant ana!ysis (CDA), correspondence analysis $\dottedsquare$(CA), $\dottedsquare$nonmetric multidimensional sca!ing (NMDS), ordination analysis, principal component ana!ysis (PCA), principal coordinate analysis (PCoA), redundancyana!ysis (RDA), statistical methods.},
