	abstract = {Canonical variate analysis is the appropriate descriptive technique for multivariate data which have an apriori group structure, but problems arise with this technique when there are more variables than within-group degrees of freedom because of singularity of matrices. In such cases it is shown through illustrative examples that principal component analysis is a viable substitute provided that the principal components are ranked according to the canonical variate criterion (ratio of between- to within-group variances) rather than the usual criterion of total variance. This ranking can also be used to select components for subsequent discriminant analysis.},
	author = {Krzanowski, W. J.},
	file = {/Users/andrea/Documents/_DBXAndrea/Zotero/storage/8GR67DZK/Krzanowski1992_Ranking_principal.pdf},
	journal = {Journal Of Chemometrics},
	pages = {97--102},
	title = {Ranking Principal Components to Reflect Group Structure},
	volume = {6},
	year = {1992}}

